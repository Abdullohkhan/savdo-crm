# --- API ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/savdo
# Test bazasi (api testlari shu bazani tozalab ishlatadi)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/savdo_test
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
REFRESH_TOKEN_DAYS=30
PORT=3000
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Seed: Atoyo korxonasi OWNER foydalanuvchisi
SEED_OWNER_NAME=Owner
SEED_OWNER_PHONE=+998900000000
SEED_OWNER_PASSWORD=change-me

# --- WEB ---
# Dev'da Vite /api ni API ga proxy qiladi
VITE_API_URL=/api

# --- Telegram (ixtiyoriy; bo'sh bo'lsa faqat ilova ichidagi bildirishnoma) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# false — bot /start buyruqlarini qabul qilmaydi (faqat yuboradi)
TELEGRAM_POLLING=true
# false — kunlik eslatmalar (09:00 Toshkent) va Telegram outbox o'chiriladi
SCHEDULER_ENABLED=true
